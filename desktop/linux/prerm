#!/bin/sh
set -eu

profile=/usr/share/podbag-desktop/podbag-desktop-engine
link=/etc/apparmor.d/podbag-desktop-engine
if [ "$1" = remove ] && [ "$(readlink "$link" || true)" = "$profile" ]; then
    if command -v apparmor_parser >/dev/null; then
        apparmor_parser -R "$link" 2>/dev/null || true
    fi
    rm -f "$link"
fi

# The podbag command that the app made: a link to its podbag.
cli=/usr/local/bin/podbag
if [ "$1" = remove ] && [ "$(readlink "$cli" || true)" = /usr/lib/podbag-desktop/podbag ]; then
    rm -f "$cli"
fi
